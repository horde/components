#!/usr/bin/env php
<?php
/**
 * Horde Components CLI Tool / GitHub Webhook Handler
 *
 * When run via CLI: Components development tool
 * When run via web server: GitHub webhook handler
 *
 * Copyright 2026 Horde LLC (http://www.horde.org/)
 */

// horde-components standalone run in composer setups
$autoloaders = [
    __DIR__ . '/../config/autoload.php', // custom autoload config
    __DIR__ . '/../vendor/autoload.php', // components is root app
    __DIR__ . '/../../../vendor/autoload.php', // components is installed in a horde-deployment
    // handle "git developer install" and pear cases
    'Horde/Autoloader/Default.php'
];

foreach ($autoloaders as $autoloader) {
    if (file_exists($autoloader)) {
        require_once $autoloader;
        $configured = true;
        break;
    }
}

if (!class_exists('Horde\Components\Components')) {
    echo "You need to run 'composer install' first\n";
    exit;
}

// Detect execution mode
if (php_sapi_name() === 'cli' || php_sapi_name() === 'cli-server') {
    // CLI mode - normal components operation
    Horde\Components\Components::main();
} else {
    // Web server mode - webhook handler

    // Read configuration from environment or defaults
    $dataDir = getenv('WEBHOOK_DATA_DIR') ?: '/horde/json';
    $secret = getenv('WEBHOOK_SECRET') ?: null;

    // Extract headers
    $headers = [
        'X-GitHub-Event' => $_SERVER['HTTP_X_GITHUB_EVENT'] ?? '',
        'X-Hub-Signature-256' => $_SERVER['HTTP_X_HUB_SIGNATURE_256'] ?? '',
        'X-GitHub-Delivery' => $_SERVER['HTTP_X_GITHUB_DELIVERY'] ?? '',
    ];

    // Read payload
    $json = file_get_contents('php://input');

    try {
        // Process webhook
        $handler = new \Horde\Components\Website\WebhookHandler($dataDir, $secret);
        $handler->handle($json, $headers);
        $handler->sendResponse(200, 'ok');
    } catch (Exception $e) {
        error_log("Webhook handler error: " . $e->getMessage());
        http_response_code(500);
        header('Content-Type: application/json');
        echo json_encode(['status' => 'error', 'message' => 'Internal server error']);
    }
}

