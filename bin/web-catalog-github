#!/usr/bin/env php
<?php
/**
 * Generate Component Catalog from GitHub API
 *
 * Fetches all public repositories from the github.com/horde organization
 * and creates a complete components.json catalog file.
 *
 * Copyright 2026 The Horde Project (http://www.horde.org/)
 */

declare(strict_types=1);

class GitHubApiClient
{
    private string $token;
    private string $baseUrl = 'https://api.github.com';

    public function __construct(?string $token = null)
    {
        // Try to get token from environment or parameter
        $this->token = $token ?? getenv('GITHUB_TOKEN') ?? '';
    }

    /**
     * Fetch all repositories for an organization
     */
    public function getOrgRepositories(string $org): array
    {
        $repos = [];
        $page = 1;
        $perPage = 100;

        echo "Fetching repositories from GitHub API...\n";

        while (true) {
            $url = "{$this->baseUrl}/orgs/{$org}/repos?type=public&per_page={$perPage}&page={$page}&sort=name";

            echo "  Fetching page $page...\n";

            $data = $this->makeRequest($url);

            if (empty($data)) {
                break;
            }

            $repos = array_merge($repos, $data);

            // GitHub returns empty array when no more pages
            if (count($data) < $perPage) {
                break;
            }

            $page++;

            // Rate limiting: be nice to GitHub
            usleep(100000); // 0.1 second delay
        }

        echo "  Total repositories fetched: " . count($repos) . "\n";

        return $repos;
    }

    /**
     * Get details for a specific repository
     */
    public function getRepository(string $owner, string $repo): ?array
    {
        $url = "{$this->baseUrl}/repos/{$owner}/{$repo}";
        return $this->makeRequest($url);
    }

    /**
     * Make HTTP request to GitHub API
     */
    private function makeRequest(string $url): ?array
    {
        $headers = [
            'User-Agent: Horde-Component-Catalog-Generator',
            'Accept: application/vnd.github+json',
        ];

        if (!empty($this->token)) {
            $headers[] = "Authorization: Bearer {$this->token}";
            $headers[] = 'X-GitHub-Api-Version: 2022-11-28';
        }

        $context = stream_context_create([
            'http' => [
                'header' => implode("\r\n", $headers),
                'timeout' => 30,
            ]
        ]);

        $response = @file_get_contents($url, false, $context);

        if ($response === false) {
            $error = error_get_last();
            fwrite(STDERR, "WARNING: Failed to fetch {$url}: {$error['message']}\n");

            // Check rate limit
            $this->checkRateLimit();

            return null;
        }

        $data = json_decode($response, true);

        if ($data === null) {
            fwrite(STDERR, "WARNING: Invalid JSON response from {$url}\n");
            return null;
        }

        return $data;
    }

    /**
     * Check GitHub API rate limit
     */
    private function checkRateLimit(): void
    {
        $url = "{$this->baseUrl}/rate_limit";
        $data = $this->makeRequest($url);

        if ($data && isset($data['rate'])) {
            $rate = $data['rate'];
            echo "\nRate Limit Status:\n";
            echo "  Limit: {$rate['limit']}\n";
            echo "  Remaining: {$rate['remaining']}\n";
            echo "  Reset: " . date('Y-m-d H:i:s', $rate['reset']) . "\n\n";

            if ($rate['remaining'] < 10) {
                fwrite(STDERR, "WARNING: GitHub API rate limit nearly exhausted!\n");
                fwrite(STDERR, "Consider using a GITHUB_TOKEN for higher limits.\n");
            }
        }
    }
}

class ComponentCatalogBuilder
{
    /**
     * Build component catalog from GitHub API data
     */
    public function buildCatalog(array $repos, ?string $gitRepoDir = null): array
    {
        $components = [];

        echo "\nProcessing " . count($repos) . " repositories...\n";

        foreach ($repos as $repo) {
            if ($repo['archived'] ?? false) {
                echo "  Skipping archived: {$repo['name']}\n";
                continue;
            }

            if ($repo['disabled'] ?? false) {
                echo "  Skipping disabled: {$repo['name']}\n";
                continue;
            }

            $component = [
                'name' => $repo['full_name'],
                'description' => $repo['description'] ?? 'No description available',
                'github_url' => $repo['html_url'],
                'homepage' => $repo['homepage'] ?? null,
                'language' => $repo['language'] ?? 'PHP',
                'topics' => $repo['topics'] ?? [],
                'stars' => $repo['stargazers_count'] ?? 0,
                'created_at' => $repo['created_at'] ?? null,
                'updated_at' => $repo['updated_at'] ?? null,
                'pushed_at' => $repo['pushed_at'] ?? null,
            ];

            // Try to get version from local git checkout
            if ($gitRepoDir !== null) {
                $version = $this->getVersionFromGit($gitRepoDir, $repo['name']);
                $component['version'] = $version ?? 'unknown';
            } else {
                $component['version'] = 'unknown';
            }

            $components[] = $component;
        }

        echo "Processed " . count($components) . " active components\n";

        return $components;
    }

    /**
     * Get version from local git repository
     */
    private function getVersionFromGit(string $gitRepoDir, string $repoName): ?string
    {
        $componentDir = $gitRepoDir . '/' . $repoName;

        if (!is_dir($componentDir)) {
            return null;
        }

        // Try .horde.yml
        $hordeYml = $componentDir . '/.horde.yml';
        if (file_exists($hordeYml)) {
            $version = $this->extractVersionFromHordeYml($hordeYml);
            if ($version) {
                return $version;
            }
        }

        // Try composer.json
        $composerJson = $componentDir . '/composer.json';
        if (file_exists($composerJson)) {
            $version = $this->extractVersionFromComposer($composerJson);
            if ($version) {
                return $version;
            }
        }

        return 'dev-master';
    }

    private function extractVersionFromHordeYml(string $path): ?string
    {
        try {
            $contents = file_get_contents($path);
            if (preg_match('/^version:\s*(.+)$/m', $contents, $matches)) {
                return trim($matches[1]);
            }
        } catch (Exception $e) {
            // Ignore
        }
        return null;
    }

    private function extractVersionFromComposer(string $path): ?string
    {
        try {
            $contents = file_get_contents($path);
            $json = json_decode($contents, true);
            if (isset($json['version'])) {
                return $json['version'];
            }
        } catch (Exception $e) {
            // Ignore
        }
        return null;
    }

    /**
     * Simplify component data for output
     */
    public function simplifyForOutput(array $components): array
    {
        return array_map(function($component) {
            return [
                'name' => $component['name'],
                'version' => $component['version'],
                'description' => $component['description'],
                'github_url' => $component['github_url'],
            ];
        }, $components);
    }

    /**
     * Sort components by name
     */
    public function sortComponents(array $components): array
    {
        usort($components, fn($a, $b) => strcasecmp($a['name'], $b['name']));
        return $components;
    }
}

// Main execution
function main(array $argv): int
{
    $options = [
        'org' => 'horde',
        'output' => 'components-github.json',
        'git_dir' => null,
        'token' => null,
        'verbose' => false,
    ];

    // Parse arguments
    for ($i = 1; $i < count($argv); $i++) {
        switch ($argv[$i]) {
            case '--org':
                $options['org'] = $argv[++$i];
                break;
            case '--output':
                $options['output'] = $argv[++$i];
                break;
            case '--git-dir':
                $options['git_dir'] = rtrim($argv[++$i], '/');
                break;
            case '--token':
                $options['token'] = $argv[++$i];
                break;
            case '--verbose':
            case '-v':
                $options['verbose'] = true;
                break;
            case '--help':
            case '-h':
                echo "Generate Component Catalog from GitHub API\n\n";
                echo "Usage: php generate-component-catalog-from-github.php [options]\n\n";
                echo "Options:\n";
                echo "  --org <name>        GitHub organization name (default: horde)\n";
                echo "  --output <file>     Output JSON file (default: components-github.json)\n";
                echo "  --git-dir <path>    Local git repo directory for version info (optional)\n";
                echo "  --token <token>     GitHub API token (or set GITHUB_TOKEN env var)\n";
                echo "  --verbose, -v       Verbose output\n";
                echo "  --help, -h          Show this help\n";
                echo "\n";
                echo "Environment Variables:\n";
                echo "  GITHUB_TOKEN        GitHub personal access token for API access\n";
                echo "\n";
                echo "Rate Limits:\n";
                echo "  Without token: 60 requests/hour\n";
                echo "  With token: 5,000 requests/hour\n";
                echo "\n";
                echo "Examples:\n";
                echo "  # Basic usage (uses public API, no auth)\n";
                echo "  php generate-component-catalog-from-github.php\n";
                echo "\n";
                echo "  # With authentication for higher rate limits\n";
                echo "  export GITHUB_TOKEN=ghp_your_token_here\n";
                echo "  php generate-component-catalog-from-github.php\n";
                echo "\n";
                echo "  # With version enrichment from local git repos\n";
                echo "  php generate-component-catalog-from-github.php --git-dir ~/git/horde\n";
                echo "\n";
                return 0;
        }
    }

    try {
        echo "Horde Component Catalog Generator (GitHub API)\n";
        echo "==============================================\n\n";

        if (empty($options['token']) && empty(getenv('GITHUB_TOKEN'))) {
            echo "WARNING: No GitHub token provided. Using unauthenticated access.\n";
            echo "Rate limit: 60 requests/hour. For higher limits, set GITHUB_TOKEN.\n\n";
        }

        // Fetch repositories from GitHub
        $client = new GitHubApiClient($options['token']);
        $repos = $client->getOrgRepositories($options['org']);

        if (empty($repos)) {
            fwrite(STDERR, "ERROR: No repositories found for organization: {$options['org']}\n");
            return 1;
        }

        // Build catalog
        $builder = new ComponentCatalogBuilder();
        $components = $builder->buildCatalog($repos, $options['git_dir']);

        if (empty($components)) {
            fwrite(STDERR, "ERROR: No active components found\n");
            return 1;
        }

        // Sort and simplify
        $components = $builder->sortComponents($components);
        $components = $builder->simplifyForOutput($components);

        // Write to file
        $json = json_encode($components, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES);
        file_put_contents($options['output'], $json);

        echo "\n✓ Successfully generated component catalog from GitHub API!\n";
        echo "  Organization: {$options['org']}\n";
        echo "  Components: " . count($components) . "\n";
        echo "  Output: {$options['output']}\n";

        // Show sample
        echo "\nFirst 10 components:\n";
        foreach (array_slice($components, 0, 10) as $component) {
            echo "  - {$component['name']}";
            if ($component['version'] !== 'unknown') {
                echo " ({$component['version']})";
            }
            echo "\n";
        }

        if (count($components) > 10) {
            echo "  ... and " . (count($components) - 10) . " more.\n";
        }

        return 0;

    } catch (Exception $e) {
        fwrite(STDERR, "ERROR: {$e->getMessage()}\n");
        fwrite(STDERR, "Stack trace:\n{$e->getTraceAsString()}\n");
        return 1;
    }
}

exit(main($argv));
