{
  "compression": "GZ",
  "directories": [
    "src",
    "data/website"
  ],
  "files": [
    "LICENSE",
    "bin/horde-components"
  ],
  "finder": [
    {
      "name": "*.php",
      "exclude": [
        "tests",
        "test"
      ],
      "in": "vendor"
    },
    {
      "name": "*.po",
      "exclude": [
        "tests",
        "test"
      ],
      "in": "vendor/horde"
    }
  ],
  "blacklist": [
    "build"
  ],
  "git-version": "package_version",
  "intercept": true,
  "main": "bin/horde-components",
  "output": "build/horde-components.phar"
}
