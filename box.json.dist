{
  "compression": "GZ",
  "directories": [
    "src",
    "data"
  ],
  "files": [
    "LICENSE",
    "bin/horde-components",
    "bin/generate-dev-horde-org.php",
    "bin/generate-github-activity-html.php",
    "bin/web-catalog-github"
  ],
  "finder": [
    {
      "name": "*.php",
      "exclude": [
        "tests",
        "test"
      ],
      "in": "vendor"
    },
    {
      "name": "*.po",
      "exclude": [
        "tests",
        "test"
      ],
      "in": "vendor/horde"
    }
  ],
  "blacklist": [
    "build",
    "data/webhooks"
  ],
  "git-version": "package_version",
  "intercept": true,
  "output": "build/horde-components.phar"
}
