{
    "name": "horde/components",
    "description": "Developer tool for managing Horde components",
    "type": "horde-application",
    "homepage": "https://www.horde.org",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Gunnar Wrobel",
            "email": "p@rdus.de",
            "role": "lead"
        },
        {
            "name": "Ralf Lang",
            "email": "ralf.lang@ralf-lang.de",
            "role": "contributor"
        }
    ],
    "time": "2025-05-07",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "^2.6 || FRAMEWORK_6_0",
        "php": "^8",
        "horde/autoloader": "* || FRAMEWORK_6_0",
        "horde/argv": "* || FRAMEWORK_6_0",
        "horde/cli": "^3 || FRAMEWORK_6_0",
        "horde/cli_modular": "^3 || FRAMEWORK_6_0",
        "horde/http": "* || FRAMEWORK_6_0",
        "horde/pear": "* || FRAMEWORK_6_0",
        "horde/role": "* || FRAMEWORK_6_0",
        "horde/text_diff": "* || FRAMEWORK_6_0",
        "horde/util": "* || FRAMEWORK_6_0",
        "horde/injector": "* || FRAMEWORK_6_0",
        "horde/release": "^4 || FRAMEWORK_6_0",
        "horde/yaml": "* || FRAMEWORK_6_0",
        "horde/eventdispatcher": "* || FRAMEWORK_6_0",
        "horde/githubapiclient": "* || FRAMEWORK_6_0",
        "horde/phpconfigfile": "^0.0.1-alpha4 || FRAMEWORK_6_0"
    },
    "require-dev": {
        "horde/test": "^3 || FRAMEWORK_6_0",
        "phpunit/phpunit": "^12 || ^11 || ^10 || ^9"
    },
    "suggest": {
        "horde/test": "^3 || FRAMEWORK_6_0",
        "squizlabs/php_codesniffer": "^3.5",
        "pear/archive_tar": "^1.4",
        "phploc/phploc": "^7",
        "phpmd/phpmd": "^2.9",
        "phpunit/phpunit": "^9"
    },
    "autoload": {
        "psr-0": {
            "Components": "lib/"
        },
        "psr-4": {
            "Horde\\Components\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Components\\Test\\": "test/"
        }
    },
    "bin": [
        "bin/horde-components"
    ],
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    }
}