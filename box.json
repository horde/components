{
  "compression": "GZ",
  "directories": [
    "src",
    "data/website"
  ],
  "directories-bin": [
    "data/ci"
  ],
  "files": [
    "LICENSE",
    "bin/horde-components",
    "phpstan-bootstrap.php",
    ".php-cs-fixer.dist.php"
  ],
  "finder": [
    {
      "name": "*.php",
      "exclude": [
        "tests",
        "test",
        "phpunit",
        "phpstan",
        "php-cs-fixer"
      ],
      "in": "vendor"
    },
    {
      "name": "*.po",
      "exclude": [
        "tests",
        "test"
      ],
      "in": "vendor/horde"
    }
  ],
  "blacklist": [
    "build"
  ],
  "git-version": "package_version",
  "intercept": true,
  "main": "bin/horde-components",
  "output": "build/horde-components.phar"
}
