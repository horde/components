includes:
  # Include base PHPStan rules at level 4
  - phar://phpstan.phar/conf/config.level4.neon
  # Include shared Horde architecture rules
  - phpstan-rules.neon

parameters:
  errorFormat: github
  treatPhpDocTypesAsCertain: false
  paths:
    - src
    - test
  excludePaths:
    - src/PhpCsFixer/*
    - src/PhpStan/*  # Don't analyze the analyzers themselves
    - src/Qc/Task/Cs.php
    - src/Qc/Task/Md.php
    - src/Qc/Task/Loc.php

