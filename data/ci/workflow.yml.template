name: CI

# Generated by: horde-components {{COMPONENTS_VERSION}}
# Template version: {{TEMPLATE_VERSION}}
# Generated: {{GENERATED_DATE}}

on:
  push:
    branches: [ FRAMEWORK_6_0 ]
  pull_request:
    branches: [ FRAMEWORK_6_0 ]

jobs:
  test:
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Setup PHP {{PHP_VERSION}} (for bootstrap)
        uses: shivammathur/setup-php@v2
        with:
          php-version: '{{PHP_VERSION}}'
          coverage: none

      - name: CI Setup
        run: bash bin/ci-bootstrap.sh
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          COMPONENTS_PHAR_URL: {{COMPONENTS_PHAR_URL}}

      - name: CI Run
        run: |
          php {{WORK_DIR}}/bin/horde-components.phar ci run \
            --work-dir={{WORK_DIR}}
